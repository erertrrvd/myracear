<?xml version="1.0"?>
<!--
  cone_match.rviz —— 锥桶配准专用 RViz 预设

  Fixed Frame 已设为 laser_link（和 cone_match 默认 frame_id 一致）

  显示：
      MarkerArray  /cone_match/markers  → 锥桶球 + 连线 + 坐标轴 + 结果文字
      Grid                               → 地面网格（判断尺度）
-->
<rviz config_version="1">
  <Rviz>
    <Global Options>
      <Fixed Frame>laser_link</Fixed Frame>
      <Background Color>18; 20; 24</Background Color>
      <Frame Rate>30</Frame Rate>
      <Default Light>true</Default Light>
    </Global Options>

    <Displays>
      <Grid>
        <Class>rviz_default_plugins/Grid</Class>
        <Name>Grid</Name>
        <Enabled>true</Enabled>
        <Cell Size>1</Cell Size>
        <Plane Cell Count>20</Plane Cell Count>
        <Color>80; 85; 95</Color>
        <Alpha>0.35</Alpha>
        <Line Style>Lines</Line Style>
        <Plane>XY</Plane>
        <Offset>
          <X>0</X><Y>0</Y><Z>0</Z>
        </Offset>
      </Grid>

      <MarkerArray>
        <Class>rviz_default_plugins/MarkerArray</Class>
        <Name>锥桶配准</Name>
        <Enabled>true</Enabled>
        <Topic>
          <Value>/cone_match/markers</Value>
          <Depth>10</Depth>
          <Durability Policy>Transient Local</Durability Policy>
          <History Policy>Keep Last</History Policy>
          <Reliability Policy>Reliable</Reliability Policy>
        </Topic>
      </MarkerArray>
    </Displays>

    <Tools>
      <Tool>-1; 87; 100</Tool>
    </Tools>

    <Views>
      <Current View Class="rviz_default_plugins/Orbit" Name="Current View">
        <Target Frame>laser_link</Target Frame>
        <Distance>8</Distance>
        <Focal Point>
          <X>0</X><Y>0</Y><Z>0</Z>
        </Focal Point>
        <Yaw>0</Yaw>
        <Pitch>1.5708</Pitch>
      </Current View>
    </Views>

    <Window Geometry>
      <X>60</X><Y>60</Y>
      <Width>1280</Width><Height>800</Height>
    </Window Geometry>

    <Panels>
      <Panel>
        <Class>rviz_common/Displays</Class>
        <Name>Displays</Name>
      </Panel>
      <Panel>
        <Class>rviz_common/Views</Class>
        <Name>Views</Name>
      </Panel>
    </Panels>
  </Rviz>
</rviz>
