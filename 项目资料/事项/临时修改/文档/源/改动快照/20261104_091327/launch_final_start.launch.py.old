def generate_launch_description():
    # 获取包目录路径
    package_name = 'my_racecar'  
    
    parameters = parametersd
    
    
    return LaunchDescription([
        # 启动 GetDistance 节点
        Node(
            package=package_name,
            executable='get_distance',
            name='get_distance',
            output='screen',
            parameters=[parameters],
            remappings=[
                ('distance', '/distance')
            ]
        ),
        

        #启动里程计节点
     #   Node(
     #       package='encoder_imu',
     #       executable='imu_encoder_mix',
     #       name='imu_encoder_mix',
     #       output='screen',
     #   ),



        # 启动 GetFlag 节点
        Node(
            package=package_name,
            executable='get_flag', 
            name='get_flag',
            output='screen',
            parameters=[parameters],
            remappings=[
                ('flag', '/flag'),
                ('traffic_light', '/traffic_light')
            ]
        ),
        
        Node(
            package=package_name,  
            executable='get_middle_point',  # 可执行文件名称
            name='get_middle_point',
            output='screen',
        ),
        
        
        # 启动 MoveControl 节点
        Node(
            package=package_name,
            executable='move_control',
            name='move_control',
            output='screen',
            parameters=[parameters],
            remappings=[
                ('flag', '/flag'),
                ('middle_point', '/middle_point'),
                ('car_cmd_vel', '/car_cmd_vel')
            ]
        )
    ])